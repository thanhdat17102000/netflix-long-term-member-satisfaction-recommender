FROM apache/hadoop:3.3.6 AS hadoop

FROM python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    HADOOP_HOME=/opt/hadoop \
    HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop \
    JAVA_HOME=/usr/lib/jvm/java-17 \
    PATH="/opt/hadoop/bin:/usr/local/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        curl \
        ca-certificates \
        unzip \
        procps \
        bash \
    && rm -rf /var/lib/apt/lists/* \
    && arch="$(dpkg --print-architecture)" \
    && ln -sfn "/usr/lib/jvm/java-17-openjdk-${arch}" /usr/lib/jvm/java-17

COPY --from=hadoop /opt/hadoop /opt/hadoop
COPY docker/core-site.xml docker/hdfs-site.xml ${HADOOP_CONF_DIR}/

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt kaggle

WORKDIR /workspace
CMD ["sleep", "infinity"]
